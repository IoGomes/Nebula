<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/img_chat_screen"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/blurview"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:background="#000000"
        android:clipToOutline="true"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="04dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/ic_return"
                android:background="@android:color/transparent"
                android:contentDescription="@string/foto_de_perfil" />

            <ImageButton
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile_picture"
                android:background="@android:color/transparent"
                android:contentDescription="@string/foto_de_perfil" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="@string/nome_de_contato"
                    android:textColor="@color/white"
                    android:textSize="18dp"
                    tools:ignore="RtlSymmetry" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/space_mono_regular"
                    android:paddingStart="8dp"
                    android:text="+55 75 98806-6952"
                    android:textColor="#808080"
                    android:textSize="12dp"
                    tools:ignore="RtlSymmetry" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="104dp"
                android:layout_gravity="center"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/video_call"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_video_call"
                    android:background="@android:color/transparent" />

                <ImageButton
                    android:id="@+id/voice_call"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_call" />

            </LinearLayout>

        </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="04dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginEnd="04dp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toStartOf="@+id/send"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/normal_textfield">

            <ImageButton
                android:id="@+id/camera1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/keyboard_bg"
                android:src="@drawable/code"
                android:stateListAnimator="@animator/scale_animation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/messageTextfield"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:hint="@string/type"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:paddingStart="16dp"
                android:scrollHorizontally="false"
                android:stateListAnimator="@animator/scale_animation"
                android:textColor="@color/white"
                android:textColorHint="#99ffffff"
                app:layout_constraintBottom_toBottomOf="parent"

                app:layout_constraintEnd_toStartOf="@+id/camera"
                app:layout_constraintStart_toEndOf="@+id/camera1"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_camera"
                android:stateListAnimator="@animator/scale_animation"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageButton
            android:id="@+id/send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_login_button"
            android:padding="04dp"
            android:src="@drawable/ic_send"
            android:stateListAnimator="@animator/scale_animation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/rv_03_msg_received"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blurview">
    </androidx.recyclerview.widget.RecyclerView>

</androidx.constraintlayout.widget.ConstraintLayout>