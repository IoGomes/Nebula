<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 FPS: --"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:padding="16dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 MÉTRICAS DETALHADAS\n\nIniciando monitoramento..."
            android:textSize="13sp"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:textColor="#E65100"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧪 TESTE DE PERFORMANCE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compare diferentes abordagens e observe as métricas em tempo real!"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMainThread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Main Thread (Vai Travar)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnExecutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ ExecutorService (Recomendado)"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnThread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Thread Customizada"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Resetar Métricas"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👆 Clique em um botão para testar"
            android:textSize="14sp"
            android:padding="16dp"
            android:background="#F5F5F5"
            android:minHeight="150dp"
            android:gravity="top"/>

    </LinearLayout>

</ScrollView>