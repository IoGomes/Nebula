<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    tools:ignore="Typos">

    <LinearLayout
        android:id="@+id/fragment_container_view_tag"
        android:layout_width="match_parent"
        android:layout_height="944dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#000000"
            android:orientation="horizontal"
            android:padding="08dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/nebula"
                android:paddingStart="04dp"
                android:text="NEBULA"
                android:textColor="@color/white"
                android:textSize="30sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/teste"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_profile_picture"
                android:contentDescription="@string/profileimage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageButton
                android:id="@+id/teste2"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_profile_picture"
                android:contentDescription="@string/profileimage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/teste" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:context=".Fragments.Fragment_03_AllChats" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:background="#151515"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/button_inbox"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:clickable="false"
                    android:id="@+id/inbox"
                    android:layout_width="70dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/profileimage"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:src="@drawable/ic_inbox"
                    android:stateListAnimator="@animator/scale_animation" />

                <Space
                    android:layout_width="08dp"
                    android:layout_height="04dp" />

                <TextView
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/conversas"
                    android:textAlignment="center"
                    android:textColor="@color/white">

                </TextView>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/button_contact"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:clickable="false"
                    android:id="@+id/contact"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/profileimage"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:src="@drawable/ic_contact_list"
                    android:stateListAnimator="@animator/scale_animation" />

                <Space
                    android:layout_width="08dp"
                    android:layout_height="04dp" />

                <TextView
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Contatos"
                    android:textAlignment="center"
                    android:textColor="@color/white">

                </TextView>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/button_call"
                android:layout_width="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:clickable="false"
                    android:id="@+id/calls"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/profileimage"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:src="@drawable/ic_call"
                    android:stateListAnimator="@animator/scale_animation" />

                <Space
                    android:layout_width="08dp"
                    android:layout_height="04dp" />

                <TextView
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Ligações"
                    android:textAlignment="center"
                    android:textColor="@color/white">

                </TextView>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/button_archived"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:clickable="false"
                    android:id="@+id/archived"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:background="@null"
                    android:contentDescription="@string/profileimage"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:src="@drawable/ic_archived"
                    android:stateListAnimator="@animator/scale_animation" />

                <Space
                    android:layout_width="08dp"
                    android:layout_height="04dp" />

                <TextView
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/arquivados"
                    android:textAlignment="center"
                    android:textColor="@color/white">

                </TextView>


            </LinearLayout>

        </LinearLayout>

</LinearLayout>